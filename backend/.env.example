# Copy this file to ".env" and adjust the values before running the server.

# Port the API server listens on
PORT=4000

# Allowed origin for the frontend (use * for local testing, or your real domain in production)
CORS_ORIGIN=*

# Secret used to sign admin login tokens — replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Admin login credentials used to manage the menu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=baptiste123
